"use client";

import { useCallback, useEffect, useState } from "react";
import { onAuthStateChanged } from "firebase/auth";
import type { User } from "firebase/auth";
import {
  collection,
  getDocs,
  query,
  where,
} from "firebase/firestore";
import { auth, db } from "@/lib/firebase";

type Voucher = {
  id: string;
  code: string;
  discountType: "percentage" | "fixed";
  discountValue: number;
  expiryDate: string;
  usageLimit: number;
  usageCount: number;
  active: boolean;
};

type Campaign = {
  id: string;
  title: string;
  message: string;
  status: string;
  voucherId?: string | null;
  voucherCode?: string | null;
  sentCount?: number;
  failedCount?: number;
  createdAt?: { seconds?: number };
  scheduledAt?: { seconds?: number } | null;
};

export default function NotificationManagementPage() {
  const [user, setUser] = useState<User | null>(null);
  const [authLoading, setAuthLoading] = useState(true);
  const [loading, setLoading] = useState(false);

  const [campaigns, setCampaigns] = useState<Campaign[]>([]);
  const [vouchers, setVouchers] = useState<Voucher[]>([]);

  const [title, setTitle] = useState("");
  const [message, setMessage] = useState("");
  const [scheduledAt, setScheduledAt] = useState("");
  const [voucherId, setVoucherId] = useState("");

  const [error, setError] = useState("");
  const [notice, setNotice] = useState("");

  useEffect(() => {
    const unsubscribe = onAuthStateChanged(auth, (currentUser) => {
      setUser(currentUser);
      setAuthLoading(false);
    });

    return unsubscribe;
  }, []);

  const getToken = useCallback(async () => {
    if (!user) {
      throw new Error("Please sign in again.");
    }

    return user.getIdToken();
  }, [user]);

  const loadVouchers = useCallback(async () => {
    if (!user) return;

    try {
      const voucherQuery = query(
        collection(db, "vouchers"),
        where("cafeId", "==", user.uid)
      );

      const snapshot = await getDocs(voucherQuery);

      const loadedVouchers: Voucher[] = snapshot.docs.map((document) => {
        const data = document.data();

        return {
          id: document.id,
          code: String(data.code ?? ""),
          discountType:
            data.discountType === "fixed" ? "fixed" : "percentage",
          discountValue: Number(data.discountValue ?? 0),
          expiryDate: String(data.expiryDate ?? ""),
          usageLimit: Number(data.usageLimit ?? 0),
          usageCount: Number(data.usageCount ?? 0),
          active: Boolean(data.active),
        };
      });

      setVouchers(loadedVouchers);
    } catch (err) {
      console.error("Unable to load vouchers:", err);
      setError("Unable to load vouchers. Please check your Firebase rules.");
    }
  }, [user]);

  const loadCampaigns = useCallback(async () => {
    if (!user) return;

    setLoading(true);
    setError("");

    try {
      const token = await getToken();

      const response = await fetch(
        `/api/push/campaigns?cafeId=${encodeURIComponent(user.uid)}`,
        {
          headers: {
            Authorization: `Bearer ${token}`,
          },
        }
      );

      const data = await response.json();

      if (!response.ok) {
        throw new Error(data.error || "Unable to load campaigns.");
      }

      setCampaigns(data.campaigns ?? []);
    } catch (err) {
      setError(
        err instanceof Error ? err.message : "Unable to load campaigns."
      );
    } finally {
      setLoading(false);
    }
  }, [user, getToken]);

  useEffect(() => {
    if (user) {
      void loadVouchers();
      void loadCampaigns();
    }
  }, [user, loadVouchers, loadCampaigns]);

  const selectedVoucher = vouchers.find(
    (voucher) => voucher.id === voucherId
  );

  function formatDiscount(voucher: Voucher) {
    return voucher.discountType === "percentage"
      ? `${voucher.discountValue}% OFF`
      : `₹${voucher.discountValue} OFF`;
  }

  function formatDate(timestamp?: { seconds?: number } | null) {
    if (!timestamp?.seconds) return "—";

    return new Date(timestamp.seconds * 1000).toLocaleString();
  }

  async function createCampaign(action: "draft" | "scheduled" | "send") {
    setError("");
    setNotice("");

    if (!user) {
      setError("Please sign in again.");
      return;
    }

    if (!title.trim() || !message.trim()) {
      setError("Please enter an offer title and message.");
      return;
    }

    if (action === "scheduled" && !scheduledAt) {
      setError("Please select a date and time for the campaign.");
      return;
    }

    if (voucherId && !selectedVoucher) {
      setError("The selected voucher could not be found. Please select it again.");
      return;
    }

    setLoading(true);

    try {
      const token = await getToken();

      const campaignStatus =
        action === "scheduled" ? "scheduled" : "draft";

      const response = await fetch("/api/push/campaigns", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          Authorization: `Bearer ${token}`,
        },
        body: JSON.stringify({
          cafeId: user.uid,
          title: title.trim(),
          message: message.trim(),
          status: campaignStatus,
          voucherId: voucherId || null,
          scheduledAt:
            action === "scheduled"
              ? new Date(scheduledAt).toISOString()
              : null,
        }),
      });

      const data = await response.json();

      if (!response.ok) {
        throw new Error(data.error || "Unable to create campaign.");
      }

      if (action === "send") {
        const sendResponse = await fetch("/api/push/send", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            Authorization: `Bearer ${token}`,
          },
          body: JSON.stringify({
            cafeId: user.uid,
            campaignId: data.campaignId,
          }),
        });

        const sendData = await sendResponse.json();

        if (!sendResponse.ok) {
          throw new Error(
            sendData.error || "Campaign created, but sending failed."
          );
        }

        setNotice(
          `Campaign sent. Successful deliveries: ${sendData.sentCount}. Failed: ${sendData.failedCount}.`
        );
      } else if (action === "scheduled") {
        setNotice("Campaign scheduled successfully.");
      } else {
        setNotice("Campaign saved as a draft.");
      }

      setTitle("");
      setMessage("");
      setScheduledAt("");
      setVoucherId("");

      await loadCampaigns();
    } catch (err) {
      setError(
        err instanceof Error ? err.message : "Something went wrong."
      );
    } finally {
      setLoading(false);
    }
  }

  if (authLoading) {
    return (
      <main className="p-6">
        <p className="text-gray-500">Checking your login...</p>
      </main>
    );
  }

  if (!user) {
    return (
      <main className="p-6">
        <p className="text-gray-600">
          Please sign in to manage notifications.
        </p>
      </main>
    );
  }

  return (
    <main className="min-h-screen bg-gray-50 p-4 sm:p-6 lg:p-8">
      <div className="mx-auto max-w-6xl space-y-6">
        <div className="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
          <div>
            <p className="text-sm font-medium text-indigo-600">CafeFlow</p>

            <h1 className="mt-1 text-2xl font-bold text-gray-900 sm:text-3xl">
              Notification Management
            </h1>

            <p className="mt-2 text-sm text-gray-500">
              Create special offers and reach customers who subscribed
              to your cafe notifications.
            </p>
          </div>

          <button
            onClick={() => {
              void loadVouchers();
              void loadCampaigns();
            }}
            disabled={loading}
            className="rounded-xl border border-gray-200 bg-white px-4 py-2.5 text-sm font-semibold text-gray-700 shadow-sm hover:bg-gray-100 disabled:opacity-50"
          >
            Refresh campaigns
          </button>
        </div>

        {error && (
          <div className="rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-700">
            {error}
          </div>
        )}

        {notice && (
          <div className="rounded-xl border border-green-200 bg-green-50 p-4 text-sm text-green-700">
            {notice}
          </div>
        )}

        <section className="rounded-2xl border border-gray-200 bg-white p-5 shadow-sm sm:p-6">
          <div className="mb-5">
            <h2 className="text-lg font-bold text-gray-900">
              Create a special offer
            </h2>

            <p className="mt-1 text-sm text-gray-500">
              Create a campaign and optionally attach a voucher from
              your Voucher Management page.
            </p>
          </div>

          <div className="space-y-4">
            <div>
              <label
                htmlFor="campaign-title"
                className="mb-1.5 block text-sm font-medium text-gray-700"
              >
                Offer title
              </label>

              <input
                id="campaign-title"
                value={title}
                onChange={(event) => setTitle(event.target.value)}
                maxLength={100}
                placeholder="Weekend Special - 15% OFF"
                className="w-full rounded-xl border border-gray-200 px-4 py-3 text-sm outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100"
              />
            </div>

            <div>
              <label
                htmlFor="campaign-message"
                className="mb-1.5 block text-sm font-medium text-gray-700"
              >
                Notification message
              </label>

              <textarea
                id="campaign-message"
                value={message}
                onChange={(event) => setMessage(event.target.value)}
                maxLength={500}
                rows={4}
                placeholder="Enjoy 15% OFF this weekend! Visit our cafe and treat yourself."
                className="w-full resize-y rounded-xl border border-gray-200 px-4 py-3 text-sm outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100"
              />

              <p className="mt-1 text-right text-xs text-gray-400">
                {message.length}/500
              </p>
            </div>

            <div>
              <label
                htmlFor="campaign-voucher"
                className="mb-1.5 block text-sm font-medium text-gray-700"
              >
                Attach voucher (optional)
              </label>

              <select
                id="campaign-voucher"
                value={voucherId}
                onChange={(event) => setVoucherId(event.target.value)}
                className="w-full rounded-xl border border-gray-200 bg-white px-4 py-3 text-sm outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100"
              >
                <option value="">No voucher attached</option>

                {vouchers.map((voucher) => (
                  <option key={voucher.id} value={voucher.id}>
                    {voucher.code} — {formatDiscount(voucher)}
                    {voucher.active ? "" : " (Inactive)"}
                  </option>
                ))}
              </select>

              {vouchers.length === 0 && (
                <p className="mt-1 text-xs text-amber-600">
                  No vouchers found. Create a voucher first in Voucher
                  Management.
                </p>
              )}

              {selectedVoucher && (
                <div className="mt-3 rounded-xl border border-indigo-100 bg-indigo-50 p-4">
                  <p className="font-semibold text-indigo-900">
                    {selectedVoucher.code}
                  </p>

                  <p className="mt-1 text-sm text-indigo-800">
                    Discount: {formatDiscount(selectedVoucher)}
                  </p>

                  <p className="mt-1 text-sm text-indigo-800">
                    Expiry: {selectedVoucher.expiryDate || "Not specified"}
                  </p>

                  <p className="mt-1 text-sm text-indigo-800">
                    Usage: {selectedVoucher.usageCount} /{" "}
                    {selectedVoucher.usageLimit}
                  </p>

                  <p className="mt-2 text-xs text-indigo-700">
                    Status: {selectedVoucher.active ? "Active" : "Inactive"}
                  </p>
                </div>
              )}
            </div>

            <div>
              <label
                htmlFor="campaign-schedule"
                className="mb-1.5 block text-sm font-medium text-gray-700"
              >
                Schedule date and time (optional)
              </label>

              <input
                id="campaign-schedule"
                type="datetime-local"
                value={scheduledAt}
                onChange={(event) => setScheduledAt(event.target.value)}
                min={new Date(Date.now() + 60000)
                  .toISOString()
                  .slice(0, 16)}
                className="w-full rounded-xl border border-gray-200 px-4 py-3 text-sm outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100"
              />

              <p className="mt-1 text-xs text-gray-500">
                Leave empty to save a draft or send immediately.
              </p>
            </div>

            <div className="flex flex-col gap-3 border-t border-gray-100 pt-4 sm:flex-row sm:flex-wrap">
              <button
                onClick={() => void createCampaign("draft")}
                disabled={loading}
                className="rounded-xl border border-gray-200 bg-white px-5 py-3 text-sm font-semibold text-gray-700 hover:bg-gray-50 disabled:opacity-50"
              >
                Save draft
              </button>

              <button
                onClick={() => void createCampaign("scheduled")}
                disabled={loading || !scheduledAt}
                className="rounded-xl bg-indigo-600 px-5 py-3 text-sm font-semibold text-white hover:bg-indigo-700 disabled:opacity-50"
              >
                Schedule campaign
              </button>

              <button
                onClick={() => {
                  if (
                    window.confirm(
                      "Send this notification to all active subscribers of your cafe now?"
                    )
                  ) {
                    void createCampaign("send");
                  }
                }}
                disabled={loading || Boolean(scheduledAt)}
                className="rounded-xl bg-gray-900 px-5 py-3 text-sm font-semibold text-white hover:bg-gray-800 disabled:opacity-50"
              >
                {loading ? "Please wait..." : "Send now"}
              </button>
            </div>
          </div>
        </section>

        <section className="rounded-2xl border border-gray-200 bg-white p-5 shadow-sm sm:p-6">
          <div className="mb-5 flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
            <div>
              <h2 className="text-lg font-bold text-gray-900">
                Campaign history
              </h2>

              <p className="mt-1 text-sm text-gray-500">
                View your saved, scheduled, and sent campaigns.
              </p>
            </div>

            <span className="rounded-full bg-indigo-50 px-3 py-1 text-sm font-semibold text-indigo-700">
              {campaigns.length} campaigns
            </span>
          </div>

          {loading && campaigns.length === 0 ? (
            <p className="py-8 text-center text-sm text-gray-500">
              Loading campaigns...
            </p>
          ) : campaigns.length === 0 ? (
            <div className="rounded-xl border border-dashed border-gray-200 px-4 py-10 text-center">
              <div className="text-3xl">🔔</div>

              <p className="mt-3 font-semibold text-gray-800">
                No campaigns yet
              </p>

              <p className="mt-1 text-sm text-gray-500">
                Create your first special offer above.
              </p>
            </div>
          ) : (
            <div className="space-y-3">
              {campaigns.map((campaign) => (
                <article
                  key={campaign.id}
                  className="rounded-xl border border-gray-100 p-4"
                >
                  <div className="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
                    <div className="min-w-0">
                      <h3 className="font-semibold text-gray-900">
                        {campaign.title}
                      </h3>

                      <p className="mt-1 whitespace-pre-wrap text-sm text-gray-600">
                        {campaign.message}
                      </p>

                      {campaign.voucherCode && (
                        <p className="mt-2 text-sm font-semibold text-indigo-700">
                          Voucher: {campaign.voucherCode}
                        </p>
                      )}

                      <p className="mt-2 text-xs text-gray-400">
                        Created: {formatDate(campaign.createdAt)}
                      </p>

                      {campaign.status === "scheduled" && (
                        <p className="mt-1 text-xs text-indigo-600">
                          Scheduled: {formatDate(campaign.scheduledAt)}
                        </p>
                      )}

                      {campaign.status === "sent" && (
                        <p className="mt-1 text-xs text-gray-500">
                          Successful deliveries: {campaign.sentCount ?? 0}
                          {" · "}
                          Failed: {campaign.failedCount ?? 0}
                        </p>
                      )}
                    </div>

                    <span
                      className={`w-fit rounded-full px-3 py-1 text-xs font-semibold ${
                        campaign.status === "sent"
                          ? "bg-green-50 text-green-700"
                          : campaign.status === "scheduled"
                          ? "bg-indigo-50 text-indigo-700"
                          : campaign.status === "sending"
                          ? "bg-yellow-50 text-yellow-700"
                          : "bg-gray-100 text-gray-600"
                      }`}
                    >
                      {campaign.status}
                    </span>
                  </div>
                </article>
              ))}
            </div>
          )}
        </section>
      </div>
    </main>
  );
}